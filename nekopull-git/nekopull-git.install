post_install() {
  cat <<'MSG'
nekopull ships a systemd user timer. To switch it on for your account:

  systemctl --user daemon-reload
  systemctl --user enable --now nekopull.timer

It runs once a day at 04:00 and expects ~/.config/nekopull/config.toml;
start from /usr/share/doc/nekopull/config.example.toml.
MSG
}

post_upgrade() {
  post_install
}
