# Maintainer: tunaflsh <tunaflish.ai@gmail.com>
pkgname=cua-driver-git
_pkgname=cua
pkgver=0.47.14.r9.g1fb3c082a
pkgrel=1
pkgdesc="Desktop control daemon (cua-driver-rs) from tunaflsh/cua — background window driving, clicks, typing, browser automation via MCP"
arch=('x86_64')
url="https://github.com/tunaflsh/cua"
license=('MIT')
depends=(
    'libx11'
    'libxi'
    'libxkbcommon'
    'glibc'
    'gcc-libs'
)
optdepends=(
    'gnome-shell: wayland-helper GNOME extension (winrects@cua)'
    'ffmpeg: video capture (start_recording)'
    'wf-recorder: native Wayland video capture'
)
makedepends=(
    'git'
    'rust'
    'libxtst'
)
provides=('cua-driver')
conflicts=('cua-driver' 'cua-driver-bin')
options=('!lto')
install="${pkgname}.install"

source=("${_pkgname}::git+https://github.com/tunaflsh/cua.git"
        "cua-driver.service")
sha256sums=('SKIP'
            'SKIP')

pkgver() {
    cd "$_pkgname"
    local _desc _ver
    if _desc=$(git describe --long --tags --match 'cua-driver-rs-v*' 2>/dev/null); then
        printf '%s' "$_desc" \
            | sed 's/^cua-driver-rs-v//; s/^\([^-]*\)-\([0-9]*\)-g/\1.r\2.g/'
        return
    fi
    _ver=$(awk -F'"' '/^version = / { print $2; exit }' \
        libs/cua-driver/rust/Cargo.toml)
    printf '%s.r%s.g%s' \
        "$_ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$_pkgname/libs/cua-driver/rust"
    cargo build --release --locked \
        -p cua-driver -p cursor-theme-cli \
        --features cua-driver/portal-input
}

package() {
    cd "$_pkgname"
    local _libdir="$pkgdir/usr/lib/cua-driver"

    install -d "$_libdir"
    install -Dm755 libs/cua-driver/rust/target/release/cua-driver "$_libdir/cua-driver"
    install -Dm755 libs/cua-driver/rust/target/release/cua-cursor-theme "$_libdir/cua-cursor-theme"
    cp -R libs/cua-driver/wayland-helper "$_libdir/wayland-helper"

    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/cua-driver/cua-driver "$pkgdir/usr/bin/cua-driver"
    ln -s /usr/lib/cua-driver/cua-cursor-theme "$pkgdir/usr/bin/cua-cursor-theme"

    install -Dm644 "$srcdir/cua-driver.service" \
        "$pkgdir/usr/lib/systemd/user/cua-driver.service"

    install -Dm644 LICENSE.md \
        "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 libs/cua-driver/rust/THIRD_PARTY_NOTICES.md \
        "$pkgdir/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
}
