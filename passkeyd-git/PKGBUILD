# Maintainer: tunaflsh <tunaflish.ai@gmail.com>
pkgname=passkeyd-git
pkgver=v1.9.3.r0.4a1ce88
pkgrel=2
pkgdesc="A WebAuthn authenticator"
arch=('x86_64')
license=('GPL3')
groups=()
depends=("tpm2-tss" "systemd" 'libxcrypt' 'libxcrypt-compat')
conflicts=("${pkgname%-git}" "openrc" "runit")
# The GTK UI needs gtk4 headers, the KDE UI needs Qt6 + Qml/Quick headers
# (cxx-qt and qt-build-utils locate Qt through qmake6/qtpaths6).
makedepends=('git' 'cargo' 'gtk4' 'qt6-base' 'qt6-declarative')
provides=("${pkgname%-git}")
replaces=()
url="https://github.com/bjn7/passkeyd"
source=('git+https://github.com/bjn7/passkeyd')
sha256sums=('SKIP')
options=('!lto')
backup=('etc/passkeyd.conf' 'usr/share/passkeyd/theme.conf')
install=passkeyd.install
noextract=()

pkgver() {
  cd "$srcdir/${pkgname%-git}"
  printf "%s" "$(git describe --long --tags | sed 's/\([^-]*-\)g/r\1/;s/-/./g')"
}

# Cargo ignores MAKEFLAGS and defaults to one job per logical CPU, but each
# rustc peaks at ~2 GiB on this workspace, so that default exhausts RAM on
# smaller machines and takes the build (and its terminal) down with it.
# Size the job count from the machine instead of hardcoding it.

# Memory ceiling in MiB: the cgroup limit when the build is confined
# (container, or `systemd-run --scope -p MemoryMax=...`), else installed RAM.
_mem_ceiling_mib() {
  local rel lim
  rel=$(sed -n 's/^0:://p' /proc/self/cgroup)
  lim=$(cat "/sys/fs/cgroup${rel}/memory.max" 2>/dev/null)
  if [[ $lim =~ ^[0-9]+$ ]]; then
    printf '%d' $(( lim / 1048576 ))
  else
    awk '/^MemTotal:/ {printf "%d", $2 / 1024}' /proc/meminfo
  fi
}

# Parallel job count. Precedence:
#   1. CARGO_BUILD_JOBS, if already set (explicit user/makepkg override);
#   2. otherwise min(nproc, 60% of the memory ceiling / 2 GiB per job);
#   3. clipped to an explicit -jN from makepkg's MAKEFLAGS, if present.
_cargo_jobs() {
  local jobs ceiling_mib per_job_mib=2048 make_jobs=""

  if [[ -n ${CARGO_BUILD_JOBS:-} ]]; then
    printf '%s' "$CARGO_BUILD_JOBS"
    return
  fi

  jobs=$(nproc)
  ceiling_mib=$(_mem_ceiling_mib)

  # One job per 2 GiB, using at most 60% of the ceiling so the desktop
  # survives the build.
  if (( jobs > ceiling_mib * 6 / 10 / per_job_mib )); then
    jobs=$(( ceiling_mib * 6 / 10 / per_job_mib ))
  fi
  if (( jobs < 1 )); then
    jobs=1
  fi

  if [[ ${MAKEFLAGS:-} =~ (^|[[:space:]])-j[[:space:]]*([0-9]+) ]]; then
    make_jobs=${BASH_REMATCH[2]}
  fi
  if [[ -n $make_jobs ]] && (( make_jobs < jobs )); then
    jobs=$make_jobs
  fi

  printf '%s' "$jobs"
}

build() {
  cd "$srcdir/${pkgname%-git}"

  local jobs
  jobs=$(_cargo_jobs)
  msg2 "Building with %s parallel job(s) (%s MiB memory ceiling)" "$jobs" "$(_mem_ceiling_mib)"

  # cxx-qt's build scripts shell out to the C++ toolchain as well, so keep
  # those in step with rustc instead of letting them use every core.
  CARGO_BUILD_JOBS="$jobs" \
    CMAKE_BUILD_PARALLEL_LEVEL="$jobs" \
    NUM_JOBS="$jobs" \
    cargo build --release
}

package() {
  cd "$srcdir/${pkgname%-git}"

  # Configuration files
  install -Dm644 passkeyd.conf "$pkgdir/etc/passkeyd.conf"
  install -Dm644 theme.conf "$pkgdir/usr/share/passkeyd/theme.conf"

  # Systemd service
  install -Dm644 passkeyd.service "$pkgdir/usr/lib/systemd/system/passkeyd.service"

  # PAM service
  install -Dm644 passkeyd.pam "$pkgdir/etc/pam.d/passkeyd"

  # Icons
  install -Dm644 icons/32x32/passkeyd.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/passkeyd.png"
  install -Dm644 icons/64x64/passkeyd.png "$pkgdir/usr/share/icons/hicolor/64x64/apps/passkeyd.png"

  cd "target/release"

  # Binary installation
  install -Dm755 passkeyd "$pkgdir/usr/bin/passkeyd"
  install -Dm755 passkeyd-manager "$pkgdir/usr/bin/passkeyd-manager"
  install -Dm755 passkeyd-migrate "$pkgdir/usr/bin/passkeyd-migrate"

  # UI binary installation - ICE (Universal)
  install -Dm755 passkeyd-ice-enroll "$pkgdir/usr/lib/passkeyd/passkeyd-ice-enroll"
  install -Dm755 passkeyd-ice-select "$pkgdir/usr/lib/passkeyd/passkeyd-ice-select"
  install -Dm755 passkeyd-ice-selection "$pkgdir/usr/lib/passkeyd/passkeyd-ice-selection"

  # UI binary installation - KDE
  install -Dm755 passkeyd-kde-enroll "$pkgdir/usr/lib/passkeyd/passkeyd-kde-enroll"
  install -Dm755 passkeyd-kde-select "$pkgdir/usr/lib/passkeyd/passkeyd-kde-select"
  install -Dm755 passkeyd-kde-selection "$pkgdir/usr/lib/passkeyd/passkeyd-kde-selection"

  # UI binary installation - GTK
  install -Dm755 passkeyd-gtk-enroll "$pkgdir/usr/lib/passkeyd/passkeyd-gtk-enroll"
  install -Dm755 passkeyd-gtk-select "$pkgdir/usr/lib/passkeyd/passkeyd-gtk-select"
  install -Dm755 passkeyd-gtk-selection "$pkgdir/usr/lib/passkeyd/passkeyd-gtk-selection"

  # Database directory
  install -d -m 700 -o root -g root "$pkgdir/var/lib/passkeyd/database"
}
