# Maintainer: tunaflsh <tunaflish@gmail.com>
pkgname=uefi-rom-extract-git
pkgver=v1.0.0.r1.a368a0f
pkgrel=1
pkgdesc="UEFI Video Card ROM Extractor"
arch=('x86_64')
url="https://github.com/ccharon/UEFIRomExtract"
license=()
groups=()
depends=()
makedepends=('git' 'cmake')
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
replaces=()
backup=()
options=()
install=
source=('git+https://github.com/ccharon/UEFIRomExtract')
noextract=()
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/UEFIRomExtract"
  printf "%s" "$(git describe --long --tags | sed 's/\([^-]*-\)g/r\1/;s/-/./g')"
}

build() {
  cd "$srcdir/UEFIRomExtract"
  mkdir -p build
  cd build
  cmake ..
  make
}

package() {
  cd "$srcdir/UEFIRomExtract/build"
  install -Dm755 -t "${pkgdir}/usr/bin/" UEFIRomExtract
}
